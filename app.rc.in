#pragma code_page(65001)

101 ICON "pet.ico"

1 VERSIONINFO
 FILEVERSION @PET_VERSION_COMMA@
 PRODUCTVERSION @PET_VERSION_COMMA@
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x00040000L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "080404b0"
    BEGIN
      VALUE "CompanyName", "@PET_COMPANY@"
      VALUE "FileDescription", "@PET_FILE_DESC@"
      VALUE "FileVersion", "@PET_VERSION@"
      VALUE "InternalName", "pet-native-cpp"
      VALUE "LegalCopyright", "@PET_COPYRIGHT@"
      VALUE "OriginalFilename", "pet-native-cpp.exe"
      VALUE "ProductName", "@PET_PRODUCT@"
      VALUE "ProductVersion", "@PET_VERSION@"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0804, 1200
  END
END
